{
  "services": {
    "8da6d6cc-96ac-4d2b-a6bc-cfbdf6b0572f": {
      "icon": "https://raw.githubusercontent.com/two-workspaces/lightpanda/main/icon.png",
      "name": "Lightpanda",
      "build": {
        "dockerfilePath": "Dockerfile"
      },
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/health",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "repo": "https://github.com/two-workspaces/lightpanda",
        "rootDirectory": null
      },
      "variables": {
        "LIGHTPANDA_TOKEN": {
          "defaultValue": "${{secret(40)}}",
          "isOptional": false,
          "description": "Access token. Send it as Authorization: Bearer <token> or as ?token=<token> in the URL. Without it every request gets 401."
        },
        "LIGHTPANDA_ARGS": {
          "defaultValue": "",
          "isOptional": true,
          "description": "Extra flags for lightpanda serve, e.g. --http-proxy <url>, --user-agent <ua>, --obey-robots, --cdp-max-connections 32."
        },
        "PORT": {
          "defaultValue": "8080",
          "isOptional": false,
          "description": "Port of the token gate behind the Railway domain - leave as is."
        }
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>:8080": {
            "port": 8080
          }
        },
        "tcpProxies": {}
      },
      "volumeMounts": {}
    }
  }
}