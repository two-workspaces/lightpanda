{
	admin off
	auto_https off
}

:{$PORT} {
	# Railway healthcheck, no token needed.
	handle /health {
		rewrite * /json/version
		reverse_proxy 127.0.0.1:9222
	}

	@authed expression `{header.Authorization} == "Bearer {$LIGHTPANDA_TOKEN}" || {query.token} == "{$LIGHTPANDA_TOKEN}"`

	handle @authed {
		# Lightpanda advertises ws://127.0.0.1:9222; hand CDP clients the public URL instead.
		@version path /json/version /json/version/
		route {
			respond @version `{"Browser":"Lightpanda/1.0","Protocol-Version":"1.3","webSocketDebuggerUrl":"{ws}://{hostport}/{wsq}"}`
			uri query -token
			# Lightpanda only accepts loopback Host and no Origin (DNS-rebinding guard); the token gate already decided.
			reverse_proxy 127.0.0.1:9222 {
				header_up Host 127.0.0.1:9222
				header_up -Origin
			}
		}
	}

	handle {
		respond "Unauthorized: send Authorization: Bearer <LIGHTPANDA_TOKEN> or ?token=<LIGHTPANDA_TOKEN>" 401
	}

	map {header.X-Forwarded-Proto} {ws} {
		https wss
		default ws
	}
	map {query.token} {wsq} {
		"" ""
		default ?token={query.token}
	}
}
